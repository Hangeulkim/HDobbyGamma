<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>HDobbyGamma</AssemblyName>
    <RootNamespace>GammaControl</RootNamespace>
    <ApplicationIcon>assets\hdobby-gamma.ico</ApplicationIcon>
    <Product>HDobby Gamma</Product>
    <AssemblyTitle>HDobby Gamma</AssemblyTitle>
    <Company>HDobby</Company>
    <Authors>HDobby (Hangeulkim)</Authors>
    <Description>Per-monitor gamma control for Windows 11.</Description>
    <Copyright>Copyright © 2026 HDobby (Hangeulkim)</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Version>1.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Include="assets\hdobby-gamma.ico" LogicalName="HDobbyGamma.Icon" />
  </ItemGroup>
</Project>
